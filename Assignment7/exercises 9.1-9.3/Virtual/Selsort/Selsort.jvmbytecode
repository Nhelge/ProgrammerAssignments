  public static void SelectionSort(int[]);
    descriptor: ([I)V
    flags: (0x0009) ACC_PUBLIC, ACC_STATIC
    Code:
      stack=4, locals=4, args_size=1
         // local 0 = arr (argument)
         // local 1 = i
         // local 2 = least
         // local 3 = j (later reused for tmp)

         // ---- i = 0, hop til ydre løkke-test ----
         0: iconst_0                        // push 0
         1: istore_1                        // i = 0

         // ---- ydre løkke-test: i < arr.length ----
         2: iload_1                         // push i
         3: aload_0                         // push arr
         4: arraylength                     // push arr.length
         5: if_icmpge     57                // if i >= arr.length, return

         // ---- ydre løkke: least = i; j = i+1 ----
         8: iload_1                         // push i
         9: istore_2                        // least = i
        10: iload_1                         // push i
        11: iconst_1                        // push 1
        12: iadd                            // push i+1
        13: istore_3                        // j = i+1

         // ---- indre løkke-test: j < arr.length ----
        14: iload_3                         // push j
        15: aload_0                         // push arr
        16: arraylength                     // push arr.length
        17: if_icmpge     37                // if j >= arr.length, exit inner loop

         // ---- indre løkke: if (arr[j] < arr[least]) ----
        20: aload_0                         // push arr
        21: iload_3                         // push j
        22: iaload                          // push arr[j]
        23: aload_0                         // push arr
        24: iload_2                         // push least
        25: iaload                          // push arr[least]
        26: if_icmpge     31                // if arr[j] >= arr[least], skip

        29: iload_3                         // push j
        30: istore_2                        // least = j

         // ---- j++ ----
        31: iinc          3, 1              // j = j+1
        34: goto          14                // jump to inner test

         // ---- swap: tmp = arr[i]; arr[i] = arr[least]; arr[least] = tmp ----
        37: aload_0                         // push arr
        38: iload_1                         // push i
        39: iaload                          // push arr[i]
        40: istore_3                        // tmp = arr[i]
        41: aload_0                         // push arr
        42: iload_1                         // push i
        43: aload_0                         // push arr
